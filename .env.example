# Copy this file to .env.local and fill in the values.
# Supabase Dashboard → Project Settings → API (or "Connect" button)

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "Publishable" key (sb_publishable_...). The older "anon public" key also works here.
# Never put the "secret" / "service_role" key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Where the site runs. On Vercel set this to your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
